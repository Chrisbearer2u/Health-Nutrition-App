# Release/upload keystore config for Play Store App Bundle signing.
# Copy this file to android/key.properties and fill in your values.
# NEVER commit key.properties or your .jks/.keystore file.
#
# Create the keystore with:
#   keytool -genkey -v -keystore upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias nutriguide-upload
#
# storeFile is relative to the android/ directory.
storeFile=../upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=nutriguide-upload
keyPassword=YOUR_KEY_PASSWORD
