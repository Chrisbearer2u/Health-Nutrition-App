# Copy to .env (never commit) or set these in your deploy environment.

# Required — your Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model to use. Defaults to claude-opus-5 if unset.
ANTHROPIC_MODEL=claude-opus-5

# Max tokens per assistant reply (default 4096).
MAX_TOKENS=4096

# Optional shared secret the app sends as X-App-Key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If set, configure the same value in the app (see app/lib/config.dart or
# pass --dart-define=APP_KEY=... when building the app bundle).
APP_KEY=

# Per-client rate limit.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# CORS: comma-separated origins, or * for any.
ALLOWED_ORIGINS=*
